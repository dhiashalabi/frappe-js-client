{
    "name": "frappe-js-client-monorepo",
    "private": true,
    "description": "Monorepo for frappe-js-client (core client) and @frappe-js-client/codegen.",
    "license": "MIT",
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": ">=20",
        "pnpm": ">=11"
    },
    "homepage": "https://dhiashalabi.github.io/frappe-js-client/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dhiashalabi/frappe-js-client.git"
    },
    "bugs": {
        "url": "https://github.com/dhiashalabi/frappe-js-client/issues"
    },
    "scripts": {
        "build": "pnpm -r --filter=./packages/* run build",
        "clean": "pnpm -r --filter=./packages/* run clean",
        "prepare": "husky",
        "test": "pnpm -r --filter=./packages/* run test",
        "test:watch": "pnpm --filter frappe-js-client run test:watch",
        "test:integration": "pnpm --filter frappe-js-client run test:integration",
        "test:live": "pnpm --filter frappe-js-client run test:live",
        "coverage": "pnpm --filter frappe-js-client run coverage",
        "lint": "pnpm -r --filter=./packages/* run lint",
        "lint:fix": "pnpm -r --filter=./packages/* run lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "pnpm --filter frappe-js-client run build && pnpm -r --filter=./packages/* run typecheck",
        "lint:deps": "pnpm --filter frappe-js-client run lint:deps",
        "api:extract": "pnpm --filter frappe-js-client run api:extract",
        "api:check": "pnpm --filter frappe-js-client run api:check",
        "publint": "pnpm -r --filter=./packages/* run publint",
        "attw": "pnpm -r --filter=./packages/* run attw",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "size-limit": "pnpm -r --filter=./packages/* run size-limit",
        "gate": "pnpm -r --filter=./packages/* run gate",
        "docs:start": "pnpm --dir docs start",
        "docs:build": "pnpm --dir docs build",
        "docs:typecheck": "pnpm --dir docs typecheck"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "prettier": "3.9.6"
    }
}
