# Local Frappe sites for opt-in tests. Copy to `.env` — never commit secrets.

# Integration and browser suites (`pnpm test:integration`, `pnpm test:browser`)
FRAPPE_TEST_URL=http://frappe14.localhost:8000
FRAPPE_TEST_SITE_NAME=
FRAPPE_TEST_API_VERSION=
FRAPPE_TEST_FRAPPE_VERSION=
FRAPPE_TEST_API_KEY=
FRAPPE_TEST_API_SECRET=
FRAPPE_TEST_ADMIN_USER=Administrator
FRAPPE_TEST_ADMIN_PASSWORD=admin

# Live suite (`pnpm test:live`)
FRAPPE_LIVE_URL=http://127.0.0.1:8001
