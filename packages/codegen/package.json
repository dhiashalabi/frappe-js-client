{
    "name": "frappe-codegen",
    "version": "1.1.0",
    "description": "CLI that reads a live Frappe site's DocType metadata and emits typed TypeScript interfaces for frappe-js-client.",
    "author": "Dhia A. Shalabi <dhia.shalabi@gmail.com>",
    "license": "MIT",
    "type": "commonjs",
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "frappe",
        "frappe-framework",
        "codegen",
        "typescript",
        "cli"
    ],
    "homepage": "https://dhiashalabi.github.io/frappe-js-client/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dhiashalabi/frappe-js-client.git",
        "directory": "packages/codegen"
    },
    "bugs": {
        "url": "https://github.com/dhiashalabi/frappe-js-client/issues"
    },
    "bin": {
        "frappe-codegen": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "pnpm clean && tsup && node scripts/verify-dist.mjs",
        "codegen": "node ./dist/cli.js",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "prepack": "pnpm clean && pnpm build",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "publint": "publint",
        "attw": "attw --pack . --profile node16",
        "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm publint && pnpm attw"
    },
    "dependencies": {
        "frappe-js-client": "workspace:^"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.1",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.12.0",
        "publint": "^0.3.24",
        "tsup": "^8.5.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
