{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "types": ["node", "vitest"],
        "rootDir": ".",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "isolatedModules": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src",
        "tests",
        "vitest.config.mts",
        "vitest.realtime.config.mts",
        "vitest.live.config.mts",
        "vitest.integration.config.mts",
        "tsup.config.ts"
    ]
}
